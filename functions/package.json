{
  "name": "knz-scent-admin-tools",
  "description": "Firebase Administrator tooling for KNZ Scent Admin",
  "private": true,
  "scripts": {
    "lint": "node --check scripts/bootstrap_admin.js && node --check scripts/verify_bootstrap_admin.js && node --check test/bootstrap_admin.test.js",
    "test": "npm run test:unit",
    "test:unit": "node --test test/bootstrap_admin.test.js",
    "test:rules": "firebase --config ../firebase.json emulators:exec --project demo-knz-scent --only auth,firestore \"npm --prefix ../rules-tests test\"",
    "bootstrap:admin": "node scripts/bootstrap_admin.js",
    "bootstrap:verify-auth": "node scripts/verify_bootstrap_admin.js --auth-only",
    "bootstrap:verify": "node scripts/verify_bootstrap_admin.js",
    "deploy:firestore": "firebase --config ../firebase.json deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0"
  },
  "engines": { "node": "20" }
}
