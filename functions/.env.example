# Non-secret Firebase Functions parameters. Set these with the Firebase CLI or
# a project-specific functions environment file; never put real credentials here.
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=KNZ Scent
OTP_ENFORCE_APP_CHECK=false

# Required secrets (set with `firebase functions:secrets:set NAME`):
# BREVO_API_KEY
# OTP_SECURITY_SECRET  (generate at least 32 random bytes)
